import("format/format.inc")
x86.use64()

let image: map = format_elf64(
    format_elf_exec,
    list.of(
        format_segment(
            ".text",
            format_load | format_readable | format_executable
        )
    )
)
format_begin(image)

format_segment_begin(image, ".text")
start:
    mov eax, 60
    xor edi, edi
    syscall
format_segment_end(image, ".text")

format_entry_mut(image, start)
format_finish(image)
