let fields: map = map.new()
map.set_mut(fields, "magic", b"XR")
map.set_mut(fields, "version", bytes.le(3, 2))

const keys: list = map.keys(fields)
const values: list = map.values(fields)

assert(len(keys) == 2)
assert(len(values) == 2)

for value in values {
    emit.bytes(value)      // 先 58 52，再 03 00
}
