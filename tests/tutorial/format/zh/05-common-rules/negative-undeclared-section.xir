# expect-error: format section is not declared
import("format/format.inc")

// 配置里只声明了 .text，却去写 .rodata。
let image: map = format_pe64(
    format_pe_exe | format_pe_console | format_pe_nx | format_pe_aslr_disabled,
    list.of(
        format_section(".text", format_code | format_readable | format_executable)
    )
)
format_begin(image)
format_section_begin(image, ".text")
start:
    ret
format_section_end(image, ".text")
format_section_begin(image, ".rodata")
data_here:
    dd(1)
format_section_end(image, ".rodata")
format_entry_mut(image, start)
format_finish(image)
